{
    "name"              : "[COLOR blue]s4me[/COLOR]_Anime[COLOR violet]Saturn[/COLOR]",
    "plugin"            : "plugin.video.s4me",
    "priority"          : 100,
    "is_resolvable"     : "false",
    "make_playlist"     : "upnext",
	"assert": {
        "play_movie"    : ["title","year"],
        "play_episode"  : ["showname","season","episode"]
	},
    "play_movie": [
        "plugin://plugin.video.s4me/?action=search&channel=animesaturn",
        {"keyboard": "{title}"},
        {"dialog": "auto", "strict": "true", "label": "{title}", "title": "(?i)^.*{title}.*(\\[ITA\\|\\[Sub-ITA\\]]).*$", "year": "{year}"},
		{"position": "1"}
    ],
	"play_episode": [
        "plugin://plugin.video.s4me/?action=search&channel=animesaturn",
        {"keyboard": "{showname}"},
        {"label": "(?i)^.*{showname}.*\\[ITA\\].*$", "year": "{showyear}"},
        {"return": "true", "season": "{season}", "episode": "{episode}"},
        {"return": "true", "episode": "{episode}"},
        {"episode": "-1"},
        {"return": "true", "episode": "{episode}"},
        {"episode": "-1"},
        {"return": "true", "episode": "{episode}"},
        {"episode": "-1"},
        {"episode": "{episode}"}
    ],
    "search_episode": [
        "plugin://plugin.video.s4me/?action=search&channel=animesaturn",
        {"keyboard": "{showname}"},
		{"dialog": "true"}
    ],
    "fallback": {
        "play_movie": "S4Me_player_a_as_eng.json play_movie",
        "play_episode": "S4Me_player_a_as_sub.json play_episode"
    }
}