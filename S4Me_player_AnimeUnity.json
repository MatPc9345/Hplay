{
    "name": "[COLOR blue]s4me[/COLOR]_[COLOR orange]AnimeUnity[/COLOR] ITA",
    "plugin": "plugin.video.s4me",
    "priority": 100,
    "is_resolvable": "false",
    "assert": {
        "play_movie": [
            "title",
            "year"
        ],
        "play_episode": [
            "showname",
            "season",
            "episode"
        ]
    },
    "play_movie": [
        "plugin://plugin.video.s4me/?%3D",
        {
            "keyboard": "{title}"
        },
        {
            "dialog": "auto",
            "label": "(?i)^(?!.*\\b(movie|film|ova|ona|special)\\b)(?=.*\\[ITA\\]).*$"
        }
    ],
    "play_episode": [
        "plugin://plugin.video.s4me/?%3D",
        {
            "keyboard": "{showname}"
        },
        {
            "dialog": "auto",
            "label": "(?i)^(?!.*\\b(movie|film|ova|ona|special)\\b)(?=.*\\[ITA\\]).*$"
        },
        {
            "label": "(?i)^.*\\b{episode}\\. (Episodio|Parte) {episode}\\b.*$"
        }
    ],
    "fallback": {
        "play_movie": "S4Me_player_AnimeUnity_sub.json play_movie",
        "play_episode": "S4Me_player_AnimeUnity_sub.json play_episode"
    }
}